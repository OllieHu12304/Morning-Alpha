# 複製為 .env 後，將密碼替換成 Morning Alpha app user 的真實密碼。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=morning_alpha_app
MYSQL_PASSWORD=replace_with_your_mysql_password
MYSQL_DATABASE=morning_alpha

# MySQL integration tests 專用設定；不要使用正式 database。
RUN_MYSQL_INTEGRATION=0
MYSQL_TEST_HOST=localhost
MYSQL_TEST_PORT=3306
MYSQL_TEST_USER=morning_alpha_test_user
MYSQL_TEST_PASSWORD=replace_with_your_test_mysql_password
MYSQL_TEST_DATABASE=morning_alpha_test
